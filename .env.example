# Source document to index
SOURCE_PDF = "datasource/Rose Gladson AG_.NETAzureOpsFullStack.pdf"

# PostgreSQL connection.
# Either set DATABASE_URL, or the individual POSTGRES_* variables.
# DATABASE_URL = "postgresql://postgres:admin@127.0.0.1:5432/rag_agent"
POSTGRES_HOST = "127.0.0.1"
POSTGRES_PORT = "5432"
POSTGRES_USER = "postgres"
POSTGRES_PASSWORD = "admin"
POSTGRES_DB = "rag_agent"

# Embedding model (runs locally on the CPU via sentence-transformers).
EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DEVICE = "cpu"
EMBEDDING_BATCH_SIZE = "32"
EMBEDDING_NORMALIZE = "true"
EMBEDDING_MAX_SEQ_LENGTH = "512"

# Hugging Face token, needed to download gated or private models.
# The free Hub download does not consume Hub credits.
HF_TOKEN = ""

# LLM provider (Groq). The chat API needs GROQ_API_KEY to answer.
GROQ_API_KEY = ""
LLM_MODEL = "llama-3.3-70b-versatile"
LLM_TEMPERATURE = "0.2"
LLM_MAX_TOKENS = "1024"

# Chat behaviour.
# CHAT_TOP_K = "5"                   # chunks retrieved per question
# CHAT_HISTORY_TURNS = "5"           # past turns replayed to the model
# CHAT_QUERY_HISTORY_MESSAGES = "2"  # past questions folded into the search

# Where the chat API listens.
# API_HOST = "127.0.0.1"
# API_PORT = "8000"
