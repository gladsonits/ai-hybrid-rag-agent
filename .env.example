# Source document to index
SOURCE_PDF = "datasource/Rose Gladson AG_.NETAzureOpsFullStack.pdf"

# PostgreSQL connection.
# Either set DATABASE_URL, or the individual POSTGRES_* variables.
# DATABASE_URL = "postgresql://postgres:admin@127.0.0.1:5432/rag_agent"
POSTGRES_HOST = "127.0.0.1"
POSTGRES_PORT = "5432"
POSTGRES_USER = "postgres"
POSTGRES_PASSWORD = "admin"
POSTGRES_DB = "rag_agent"

# Embedding model (runs locally on the CPU via sentence-transformers).
EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DEVICE = "cpu"
EMBEDDING_BATCH_SIZE = "32"
EMBEDDING_NORMALIZE = "true"
EMBEDDING_MAX_SEQ_LENGTH = "512"

# Hugging Face token, needed to download gated or private models.
# The free Hub download does not consume Hub credits.
HF_TOKEN = ""

# LLM provider (Groq). The chat API needs GROQ_API_KEY to answer.
GROQ_API_KEY = ""
LLM_MODEL = "llama-3.3-70b-versatile"
LLM_TEMPERATURE = "0.2"
LLM_MAX_TOKENS = "1024"

# The augmentation step - what the model is given.
# AUGMENT_TOP_K = "5"                     # chunks retrieved per question
# AUGMENT_HISTORY_TURNS = "5"             # past turns replayed verbatim
# AUGMENT_QUERY_HISTORY_MESSAGES = "2"    # past questions folded into the search
# AUGMENT_MAX_HISTORY_TOKENS = "2000"     # budget for the replayed history
# AUGMENT_SUMMARY_MAX_TOKENS = "400"      # cap on the length of the summary

# The distributed memory - Redis, run by Docker (docker compose up -d redis).
# REDIS_URL overrides the four variables below.
REDIS_HOST = "127.0.0.1"
REDIS_PORT = "6379"
REDIS_PASSWORD = "ragredis"
REDIS_DB = "0"
CACHE_TTL_SECONDS = "3600"

# The FAQ rule - what makes a question a frequently asked question.
# FAQ_ENABLED = "true"                  # the whole FAQ layer on or off
# FAQ_SIMILARITY_THRESHOLD = "0.90"     # how close two questions have to be to count as the same
# FAQ_PROMOTE_ASKS = "3"                # how many times it has to be asked
# FAQ_PROMOTE_HITS = "1"                # how many times the memory has to have served it
# FAQ_FRESH_SECONDS = "86400"           # how long it stays fresh
# FAQ_TTL_SECONDS = "86400"             # how long the answer to an FAQ is kept
# FAQ_MAX_ENTRIES = "500"               # how many questions are tracked at once

# Where the chat API listens.
# API_HOST = "127.0.0.1"
# API_PORT = "8000"
